// use prisma-8
model Level {
  id        Int      @id @default(autoincrement())
  number    Int      @unique
  imagePath String
  targets   Target[]
}

model Target {
  id          Int       @id @default(autoincrement())
  x           Float
  y           Float

  level       Level     @relation(fields: [levelId], references: [id])
  levelId     Int
  character   Character @relation(fields: [characterId], references: [id])
  characterId Int

  @@unique([levelId, characterId])
}

model Character {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  imagePath String
  targets   Target[]
}
